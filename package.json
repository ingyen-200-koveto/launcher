{
  "name": "icemine-launcher",
  "productName": "IceMine Launcher",
  "version": "1.0.0",
  "description": "Az IceMine szerver launchere",
  "main": "src/main.js",
  "author": "IceMine",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "extract-zip": "2.0.1",
    "minecraft-launcher-core": "3.18.2",
    "msmc": "5.0.5"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "hu.icemine.launcher",
    "productName": "IceMine Launcher",
    "files": [
      "src/**/*",
      "config.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "IceMine Launcher",
      "language": "1038"
    },
    "publish": {
      "provider": "github",
      "owner": "ingyen-200-koveto",
      "repo": "launcher"
    }
  }
}
